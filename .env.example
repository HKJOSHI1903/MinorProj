# Copy this file to ".env" and fill in your key. Never commit the .env file.

# Needed for the farming assistant to write full answers (Module 3).
# Create a key at https://console.anthropic.com/ under "API keys".
# Without it the assistant still works in basic mode: it shows the matching
# advisory text instead of writing an answer.
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the answers (default: claude-opus-5-5).
# KISAN_CHAT_MODEL=claude-opus-5-5
