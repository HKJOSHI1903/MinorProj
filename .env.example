# Copy this file to ".env" and fill in your key. Never commit the .env file.

# Free option: create a Groq developer key at https://console.groq.com/keys.
# Groq provides free usage subject to its current rate limits.
GROQ_API_KEY=
# auto prefers Groq when configured, then Claude. Or set groq / claude.
KISAN_CHAT_PROVIDER=auto
# Optional: override the Groq model with one available to your account.
# KISAN_GROQ_MODEL=llama-3.3-70b-versatile

# Optional paid alternative: https://console.anthropic.com/ under "API keys".
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the answers.
# KISAN_CHAT_MODEL=claude-opus-5-5
